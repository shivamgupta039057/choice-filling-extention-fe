{
  "manifest_version": 3,
  "name": "Choice Filling Helper",
  "version": "1.0.0",
  "description": "Credit-based medical choice filling helper.",
  "permissions": ["activeTab", "storage", "scripting", "clipboardWrite"],
  "host_permissions": [
    "https://mcc.admissions.nic.in/*",
    "http://localhost:8080/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "action": {
    "default_title": "Choice Filling Helper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["index.html", "assets/*"],
      "matches": [
        "https://mcc.admissions.nic.in/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mcc.admissions.nic.in/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
